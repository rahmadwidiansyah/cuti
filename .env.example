DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=55432
DB_DATABASE=cuti_test
DB_USERNAME=postgres
DB_PASSWORD=YOUR_PASSWORD

# Alternatif pengganti DB_* di atas:
# DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@127.0.0.1:55432/cuti_test

PORT=3001
HOST=127.0.0.1
# Vite menolak NODE_ENV=local di .env. Set VITE_USER_NODE_ENV=local agar
# tombol daftar akun demo tampil di halaman login. Hapus untuk menyembunyikan.
VITE_USER_NODE_ENV=local

# Kosongkan untuk memakai server/storage.
STORAGE_DIR=

# Isi hanya bila berjalan di belakang reverse proxy.
TRUST_PROXY=
