# Salin menjadi deploy/.env, lalu isi nilainya.
# File .env tidak boleh di-commit.

# ---------------------------------------------------------------
# Aplikasi
# ---------------------------------------------------------------
NODE_ENV=production
# 0.0.0.0 wajib di dalam container, agar nginx bisa menjangkau API.
HOST=0.0.0.0
PORT=3001
TZ=Asia/Jakarta

# Percayai satu hop proxy (nginx) supaya IP pengguna tercatat di audit log.
TRUST_PROXY=1

# Direktori penyimpanan lampiran, avatar, dokumen, dan tanda tangan.
# Harus sama dengan bind mount di docker-compose.yml.
STORAGE_DIR=/app/server/storage

# ---------------------------------------------------------------
# Database PostgreSQL eksternal
# Compose ini tidak menjalankan database.
# Pilih salah satu: DATABASE_URL, atau pasangan DB_*.
# ---------------------------------------------------------------
DATABASE_URL=postgresql://cuti_app:ubah-password@10.0.0.12:5432/cuti?sslmode=require

DB_CONNECTION=pgsql
DB_HOST=
DB_PORT=5432
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# ---------------------------------------------------------------
# Compose dan Cloudflare Tunnel
# ---------------------------------------------------------------
# Port nginx di host, hanya terikat ke 127.0.0.1.
APP_PORT=3989

# Demo login bubble (auto-isi akun + kata sandi).
# Keduanya AMAN dikosongkan/false di produksi. Aktifkan hanya di lingkungan demo.
# VITE_* dipakai saat build image, SEED_* dipakai saat container mulai.
VITE_SHOW_DEMO_LOGIN=false
SEED_DEMO_ACCOUNTS=false
DEMO_PASSWORD=Cuti123!

APP_DOMAIN=cuti.example.go.id

# Diperlukan hanya bila memakai profil tunnel:
# docker compose --profile tunnel up -d
CLOUDFLARE_TUNNEL_TOKEN=
